table 'Time Calculation'
	lineageTag: cc4bb111-2ca8-4982-af79-31abcab0ebd7

	calculationGroup

		calculationItem current_period = SELECTEDMEASURE()

		calculationItem previous_period =
				CALCULATE(
				                            SELECTEDMEASURE(),
				                            DATEADD(dimdate[Date],-1,DAY)
				)

		calculationItem pct_change = ```
				
				VAR current_value = SELECTEDMEASURE()
				VAR prior_value = CALCULATE(
				                                SELECTEDMEASURE(),
				                                DATEADD(dimdate[Date],-1,DAY)
				)
				RETURN 
				DIVIDE(current_value - prior_value, prior_value)
				```

			formatStringDefinition = "0.0%"

	column 'Calculation group column'
		dataType: string
		lineageTag: 4950e21c-d1b5-407f-9eab-0fe44499cd2e
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: a0cd3e01-a673-47ef-ac18-240afdc7e4df
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

